{
  "name": "arc-agent-pay",
  "version": "0.0.1",
  "private": true,
  "description": "Agentic payments infrastructure on Circle's Arc L1 — AI agents transact USDC with on-chain spending policies.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "hello": "npm run hello -w @arc-agent-pay/shared",
    "provision": "npm run provision -w @arc-agent-pay/agent-runtime",
    "spend": "npm run spend -w @arc-agent-pay/agent-runtime",
    "simple-agent": "npm run simple-agent -w @arc-agent-pay/agent-runtime"
  },
  "engines": {
    "node": ">=22"
  }
}
