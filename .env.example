# Arc testnet wallet — your MetaMask address. The dashboard "Counterparty"
# side reads this; agent payments are sent here. Fund with testnet USDC at
# https://faucet.circle.com (pick Arc Testnet).
ARC_TEST_ADDRESS=0xYourMetaMaskAddressHere

# Simple EOA agent wallet private key — controls the agent's funds.
# AUTO-GENERATED by `npm run simple-agent` on first run; safe to leave unset.
# Testnet only. Never reuse a key on mainnet.
# AGENT_EOA_PK=

# Optional — only needed for Phase 2 smart-account paths (provision/spend
# scripts), not the Phase 3 simple-agent flow the dashboard uses.
# AGENT_SIGNER_PK=

# Optional — Circle Modular Wallets client key, for the smart-account
# bundler path. Currently unused by the dashboard. Get one from
# https://console.circle.com (API & Client Keys → Client Key,
# Allowed Domain: localhost or your deployment host).
# CIRCLE_CLIENT_KEY=

# Optional — override Arc RPC URL (defaults to https://rpc.testnet.arc.network)
# ARC_RPC_URL=
